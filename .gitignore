# ──────────────────────────────────────────────────────────────────────────────
#  .gitignore — CourseOrientation (Qt 6 / C++17)
# ──────────────────────────────────────────────────────────────────────────────

# ── Fichiers générés par qmake / cmake ────────────────────────────────────────
Makefile
Makefile.*
.qmake.cache
.qmake.stash
*.pro.user
*.pro.user.*

# ── Fichiers générés par MOC, UIC, RCC ───────────────────────────────────────
moc_*.cpp
moc_*.h
ui_*.h
qrc_*.cpp
*.moc

# ── Fichiers objets et bibliothèques ──────────────────────────────────────────
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exp
*.prl

# ── Binaires ─────────────────────────────────────────────────────────────────
*.exe
*.app
release/
debug/
Release/
Debug/

# ── Répertoires de build ──────────────────────────────────────────────────────
build/
build-*/
Build/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
_build/
out/

# ── Runtime — données générées par l'application ─────────────────────────────
course.db
course.db-shm
course.db-wal
Configuration/
*.log
app.log

# ── Artifacts de release ──────────────────────────────────────────────────────
dist/
dist-*/
AppDir/
AppImage/
*.AppImage
*.zip
*.tar.gz

# ── Documentation générée ────────────────────────────────────────────────────
docs/

# ── Qt Creator ────────────────────────────────────────────────────────────────
*.autosave
*.shiboken
.DS_Store
Thumbs.db

# ── Éditeurs ──────────────────────────────────────────────────────────────────
*~
.*.swp
.*.swo
*.orig
*.bak
*.rej
.#*
*.*#

# ── IDE — Visual Studio ──────────────────────────────────────────────────────
.vs/
*.sln
*.suo
*.vcxproj
*.vcxproj.*
*.ncb
*.sdf
*.opensdf
*.idb
*.ilk
*.pdb

# ── CI — artefacts temporaires ───────────────────────────────────────────────
*.AppImage
linuxdeployqt*.AppImage

# ── Python ────────────────────────────────────────────────────────────────────
*.pyc
__pycache__/
